// Managed by tf2ap. Edits here are replaced the next time the launcher starts.
//
// Generated because the game's own sample sets rcon_password to a published
// default, and this file runs after the command line that set the real one.
hostname "{{.Hostname}}"
rcon_password "{{.RconPassword}}"
sv_password "{{.PlayerPassword}}"

// Mann vs Machine needs 32 slots to host at all and puts six players on
// RED, which is the number worth advertising.
sv_visiblemaxplayers 6

// A wave starts when enough players have readied up, and one is enough
// here, so one player can start a wave alone.
tf_mvm_min_players_to_start 1

// Team Fortress 2 moves an idle player to spectator after mp_idlemaxtime
// minutes. Here that takes a friend off RED, the bots fill the seat, and the
// game then refuses them back on a full team.
mp_idlemaxtime 0
mp_idledealmethod 0

// The defender bots. Mode 2 fills RED when a wave begins and tops it back up
// for the rest of it; mode 0 waits for an admin's !addbots. min_players -1
// turns off the mod's own ready-up gate, which counts RED before the wave and
// would block the F4 that spawns the bots.
sm_redbots_manager_mode {{.BotsMode}}
sm_redbots_manager_defender_team_size {{.BotTeamSize}}
sm_redbots_manager_min_players -1
// Keep the bots between waves. The mod's default kicks every bot inside
// the mvm_wave_complete handler and respawns a fresh set at the next
// wave: five KickClient calls in the middle of the wave-end sequence.
// With the default, the game server froze at wave clear and the player
// lost the connection. With this, it has not. Nothing on a private
// server wants the reroll anyway.
sm_redbots_manager_kick_bots 0
// Classes the bots never play, and whether the server hands them a loadout
// from configs/defenderbots/loadout.cfg.
sm_redbots_manager_class_blacklist "{{.BotClassBlacklist}}"
// The classes the bots fill RED with, in order. Empty leaves the mod to draw
// its own team. A team named here beats the blacklist above.
sm_redbots_manager_team_composition "{{.BotTeamComp}}"
sm_redbots_manager_use_custom_loadouts {{.BotCustomLoadouts}}
// What the bots look like. Neither changes how they play: a hat each, and an
// unusual effect on that hat.
// How far the robots are taken down when RED is short of humans. Each is the
// scale at one player, rising to none at six. 100 is off.
sm_redbots_manager_blu_damage_scale {{.BluDamage}}
sm_redbots_manager_blu_health_scale {{.BluHealth}}
sm_redbots_manager_blu_speed_scale {{.BluSpeed}}

sm_redbots_manager_bot_hats {{.BotHats}}
sm_redbots_manager_bot_hat_effects {{.BotHatEffects}}

// The mission the run starts on, and whether the bots' purchases at the
// upgrade station reach the chat.
tf2ap_start_mission "{{.StartMission}}"
tf2ap_bot_upgrades_chat {{.BotUpgradesChat}}

// LAN mode skips Steam authentication. The server has no Game Server Login
// Token by default, so it never logs in to Steam, and a client trying to
// authenticate against a server with no Steam session is refused. Reaching
// players outside the network, over Steam's relay or a forwarded port, means
// a real SRCDS_TOKEN and sv_lan 0. SRCDS_REACH picks which.
sv_lan {{.Lan}}
sv_pure 0
sv_pausable 0
setpause 0

// Long enough to stop a scan, short enough that fat-fingering the password
// does not lock the operator out for a day.
sv_rcon_banpenalty 15
sv_rcon_maxfailures 10
sv_rcon_log 1

exec banned_user.cfg
exec banned_ip.cfg
