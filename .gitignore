bin/
tmp/
*.log

# The operator's settings: server passwords, the RCON password, the run's
# shape. deploy/.env.example is the committed template.
/.env

# Compiled SourcePawn output and the toolchain build.sh downloads for it.
# The source in plugin/ is the artefact we keep.
*.smx
/plugin/build/

# Built apworld bundle. Rebuilt from apworld/tf2_mvm/ on demand.
*.apworld

# The generated seeds `make seed` writes, one multiworld each. Keep them: a
# room on archipelago.gg is recreated by uploading the same file again.
/seed/

# Bridge runtime state (check queue, unlock set) when running outside compose.
# Anchored: apworld/tf2_mvm/data/ is the committed export and must stay tracked.
/data/
/bridge/data/
*.bolt
*.db

# Python bytecode from the apworld
__pycache__/
*.py[cod]

.idea/
.vscode/
*.swp
.DS_Store
