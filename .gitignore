# Built apworld bundle. Rebuilt from apworld/tf2_mvm/ on demand.
*.apworld

# Bridge runtime state (check queue, unlock set) when running outside compose.
# Anchored: apworld/tf2_mvm/data/ is the committed export and must stay tracked.
/data/
/bridge/data/
*.bolt
*.db

# Python bytecode from the apworld
__pycache__/
*.py[cod]

.idea/
.vscode/
*.swp
.DS_Store
