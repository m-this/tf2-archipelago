bin/
tmp/
*.log

# The operator's settings: server passwords, the RCON password, the run's
# shape. deploy/.env.example is the committed template.
/.env

# Compiled SourcePawn output and the toolchain build.sh downloads for it.
# The source in plugin/ is the artefact we keep.
*.smx
/plugin/build/

# Upstream sources, downloaded releases and the staged tree for the MvM
# defender bots. deploy/bots/*.sh and deploy/patches/ are what we keep.
/deploy/bots/build/

# The launcher's Windows resource, generated from tf2ap.manifest by rsrc.
*.syso

# Built apworld bundle. Rebuilt from apworld/tf2_mvm/ on demand.
*.apworld

# What `make dist` assembles for a release. Nothing in it is a source file.
/dist/

# Local Potato content is several gigabytes. Keep the validation skeleton and
# guide, never downloaded packs or an extracted TF tree.
/community-content/*.zip
/community-content/tf/*
!/community-content/tf/.gitkeep

# The generated seeds `make seed` writes, one multiworld each. Keep them: a
# room on archipelago.gg is recreated by uploading the same file again.
/seed/

# Bridge runtime state (check queue, unlock set) when running outside compose.
# Anchored: apworld/tf2_mvm/data/ is the committed export and must stay tracked.
/data/
/bridge/data/
*.bolt
*.db

# Python bytecode from the apworld
__pycache__/
*.py[cod]

.idea/
.vscode/
*.swp
.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/

# The agent instructions live here and AGENTS.md is a symlink to them, so
# this one overrides the global ignore of CLAUDE.md.
!CLAUDE.md

# go.work points the build at a checkout of the defender mod next door, for
# working on both at once. The pin in go.mod is what ships, so this is never
# committed: a workspace that reached CI would build against whatever happened
# to be on that machine.
go.work
go.work.sum
toolchain/

# Generated from proto/. `make proto` rebuilds both trees; CI regenerates and
# fails on a diff, so a checked-in copy would only ever be a second answer to
# what the contract says.
launcher/internal/gen/
launcher/web/src/tracker/data/
launcher/web/src/gen/

# The Angular build's output, which the launcher embeds. `ng build` writes it
# straight into the package that serves it, the way the kit's does; `make
# web-build` is what puts a real one there and embed-placeholders leaves a
# holding page so a fresh clone still compiles.
launcher/internal/spa/dist/

# A stray `go build ./launcher/cmd/fakelauncher` drops a 23 MB ELF here. The
# browser tests use `go run`, so nothing ever needs one on disk.
/fakelauncher
