# Serves the game's content tree to joining clients, so a community map comes
# over HTTP rather than through the game server's own transfer. That transfer
# can reach the end of a large packed BSP without the client accepting it, and
# the same download then restarts forever.
#
# Only the directories a client downloads answer. The volume also holds cfg/,
# with the rcon password, and addons/: neither is reachable here.
:80 {
	handle_path /tf/* {
		@content path /maps/* /materials/* /models/* /sound/* /particles/* /resource/*
		handle @content {
			root * /srv/tf-dedicated/tf
			file_server
		}
		respond 404
	}
	respond 404
}
