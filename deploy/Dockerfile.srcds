# The Team Fortress 2 dedicated server, with ripext and our plugin.
#
# The game files and SourceMod are downloaded at runtime into the volume at
# /home/steam/tf-dedicated. A file baked into a path a volume later covers is a
# file nobody sees, so our additions are staged in /opt and the entrypoint
# installs them once SourceMod exists.

FROM debian:stable-slim AS build

RUN apt-get update \
	&& apt-get install --yes --no-install-recommends curl ca-certificates unzip \
	&& rm -rf /var/lib/apt/lists/*

COPY deploy/env/versions.env /deploy/env/versions.env

WORKDIR /plugin
COPY plugin/build.sh ./build.sh
COPY plugin/scripting ./scripting
RUN ./build.sh


# Two small commands from the launcher, because this container is the only one
# that may write into the game tree.
#
# rcon: the entrypoint writes SourceMod's admin file after SourceMod appears in
# the runtime volume, by which time the server can already have built its admin
# cache, so the cache is refreshed over rcon.
#
# botfiles: renders the bots' loadouts and the pool they draw their names from,
# out of the same environment the admin page writes. The admin container mounts
# the game read-only on purpose, so the rendering has to happen here, and it
# uses the launcher's own packages rather than a second copy of the weapon
# catalogue in shell.
#
# The tree is listed rather than taken whole because the launcher's embedded
# assets are .dockerignored: a COPY of everything would not compile. A test in
# deploy keeps this list and what the two commands import in step.
FROM golang:1.27 AS tools

WORKDIR /repo
COPY go.mod go.sum ./
COPY gamedata gamedata
COPY launcher/cmd/rcon launcher/cmd/rcon
COPY launcher/cmd/botfiles launcher/cmd/botfiles
COPY launcher/internal/rcon launcher/internal/rcon
COPY launcher/internal/botfiles launcher/internal/botfiles
COPY launcher/internal/botlive launcher/internal/botlive
COPY launcher/internal/botloadout launcher/internal/botloadout
COPY launcher/internal/botnames launcher/internal/botnames
COPY launcher/internal/runshape launcher/internal/runshape
COPY launcher/internal/settings launcher/internal/settings
RUN CGO_ENABLED=0 go build -trimpath -o /rcon ./launcher/cmd/rcon \
	&& CGO_ENABLED=0 go build -trimpath -o /botfiles ./launcher/cmd/botfiles


# CBaseNPC and Actions, compiled, so the image carries the patches in
# deploy/patches/cbasenpc. The released CBaseNPC can leave its tools-side
# navigation cache empty after a changelevel.
#
# A minute and a half of fetching and compiling, so this stage sees nothing
# that does not change its output, and CI keeps its layers between runs. The
# pins arrive through a stage of their own that keeps only the extension lines
# of versions.env: COPY --from is keyed on the content it copies, so bumping
# any other pin leaves the build below cached.
FROM debian:stable-slim AS extension-pins

COPY deploy/env/versions.env /versions.env
RUN grep -E '^(HL2SDK|SOURCEMOD_SRC|METAMOD_SRC|AMBUILD|CBASENPC|ACTIONS)_' \
	/versions.env >/extension-pins.env


FROM debian:stable-slim AS extensions

RUN apt-get update \
	&& apt-get install --yes --no-install-recommends \
		git ca-certificates python3 clang gcc-multilib g++-multilib \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /repo
COPY --from=extension-pins /extension-pins.env deploy/env/versions.env
COPY deploy/patches/cbasenpc deploy/patches/cbasenpc
COPY deploy/patches/actions deploy/patches/actions
COPY deploy/bots/build-extensions.sh deploy/bots/build-extensions.sh
RUN BOTS_OUT=/extensions sh deploy/bots/build-extensions.sh \
	&& rm -rf deploy/bots/build


# The MvM defender bots: the mod that fills RED so a wave tuned for six players
# is winnable alone. Its own stage so a plugin edit does not refetch it, and so
# the tree it stages can be copied whole.
#
# On the Go image rather than plain Debian: the mod is a Go module dependency
# and go.mod is the pin, so staging it needs a toolchain. Everything else the
# script fetches is still a checkout or a release download.
FROM golang:1.27 AS bots

RUN apt-get update \
	&& apt-get install --yes --no-install-recommends git curl ca-certificates unzip \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /repo
COPY go.mod go.sum ./
COPY deploy/env/versions.env deploy/env/versions.env
COPY deploy/patches deploy/patches
COPY deploy/bots deploy/bots
# The pool the bots draw their names from. The launcher writes this file too,
# every start, but the package carries it so a server it has never configured
# still has names rather than six bots called "You forgot to give me a name!".
COPY launcher/internal/botnames launcher/internal/botnames
# build.sh stages the released extensions for both platforms. This image is
# Linux and carries the ones built above instead.
RUN sh deploy/bots/build.sh \
	&& rm deploy/bots/build/package/addons/sourcemod/extensions/*.ext.2.tf2.dll
COPY --from=extensions /extensions/addons deploy/bots/build/package/addons


FROM cm2network/tf2:sourcemod

ARG RIPEXT_VERSION
ARG SIGSEGV_MVM_VERSION
ARG SIGSEGV_MVM_SHA256

USER root

COPY deploy/sigmod-stamp.sh /usr/local/bin/tf2ap-sigmod-stamp

# The staged tree mirrors the game directory, so installing it is one copy.
RUN apt-get update \
	&& apt-get install --yes --no-install-recommends curl ca-certificates unzip gdb-minimal \
	&& mkdir -p /opt/tf2-archipelago \
	&& curl -fsSL -o /tmp/ripext.zip \
		"https://github.com/ErikMinekus/sm-ripext/releases/download/${RIPEXT_VERSION}/sm-ripext-${RIPEXT_VERSION}-linux.zip" \
	&& unzip -oq /tmp/ripext.zip -d /tmp/ripext \
	&& cp -r /tmp/ripext/addons /opt/tf2-archipelago/ \
	&& rm -rf /opt/tf2-archipelago/addons/sourcemod/scripting \
	&& rm -rf /tmp/ripext.zip /tmp/ripext \
	&& mkdir -p /opt/tf2-mods/sigsegv-mvm \
	&& curl -fsSL -o /tmp/sigsegv.zip \
		"https://github.com/rafradek/sigsegv-mvm/releases/download/${SIGSEGV_MVM_VERSION}/package-linux.zip" \
	&& echo "${SIGSEGV_MVM_SHA256}  /tmp/sigsegv.zip" | sha256sum -c - \
	&& unzip -oq /tmp/sigsegv.zip -d /opt/tf2-mods/sigsegv-mvm \
	&& sh /usr/local/bin/tf2ap-sigmod-stamp /opt/tf2-mods/sigsegv-mvm \
		"${SIGSEGV_MVM_VERSION}" "${SIGSEGV_MVM_SHA256}" \
	&& rm -f /tmp/sigsegv.zip \
	&& apt-get purge --yes unzip curl \
	&& apt-get autoremove --yes \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=bots /repo/deploy/bots/build/package/addons \
	/opt/tf2-archipelago/addons
COPY --from=build /plugin/build/tf2_archipelago.smx \
	/opt/tf2-archipelago/addons/sourcemod/plugins/tf2_archipelago.smx
# The plugin refuses to load without its gamedata, and a server without the
# plugin is stock Mann vs Machine with nothing saying so. The launcher embeds
# this file; the image has to carry it the same way.
COPY plugin/gamedata/tf2_archipelago.txt \
	/opt/tf2-archipelago/addons/sourcemod/gamedata/tf2_archipelago.txt
COPY deploy/srcds/tf2_archipelago.cfg \
	/opt/tf2-archipelago/cfg/sourcemod/tf2_archipelago.cfg
COPY deploy/srcds-entrypoint.sh /usr/local/bin/entrypoint.sh
COPY deploy/srcds-launch.sh /usr/local/bin/tf2ap-srcds-launch.sh
COPY --from=tools /rcon /usr/local/bin/rcon
COPY --from=tools /botfiles /usr/local/bin/tf2ap-botfiles

RUN chown -R steam:steam /opt/tf2-archipelago /opt/tf2-mods \
	&& chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/tf2ap-srcds-launch.sh

USER steam
WORKDIR /home/steam
CMD ["bash", "/usr/local/bin/entrypoint.sh"]
