# The Compose admin UI. It is the launcher's existing Angular application with
# an attached backend: Docker owns process lifecycle and .env owns settings,
# while the page observes the bridge and sends mission/RCON commands to SRCDS.

ARG NODE_VERSION
ARG TAILSCALE_VERSION

FROM golang:1.27.3 AS code

WORKDIR /src
COPY go.mod go.sum Makefile ./
COPY deploy/env/versions.env deploy/env/versions.env
COPY proto proto
RUN make proto
COPY . .
RUN make embed-placeholders


FROM node:${NODE_VERSION} AS web

WORKDIR /src
COPY launcher/web/package.json launcher/web/package-lock.json launcher/web/
RUN npm --prefix launcher/web ci --no-audit --no-fund
COPY --from=code /src /src
RUN npm --prefix launcher/web run build


FROM golang:1.27.3 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY --from=code /src /src
COPY --from=web /src/launcher/internal/spa/dist /src/launcher/internal/spa/dist
ARG LAUNCHER_VERSION=compose
RUN make launcher-compose-admin \
    COMPOSE_ADMIN_OUT=/composeadmin \
    LAUNCHER_VERSION="${LAUNCHER_VERSION}"


FROM tailscale/tailscale:${TAILSCALE_VERSION} AS tailscale


FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /composeadmin /composeadmin
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscale
ENTRYPOINT ["/composeadmin"]
