+//--------------------------------------------------------------------------------------------------------------
+// The game's CNavArea carries m_marker, m_openMarker, m_nextOpen and m_prevOpen for its own searches,
+// stamped against its own master marker. Both sides read them as "this search's", so a stamp left by
+// the game that equals this side's marker makes an area look open or closed here and its stale links
+// corrupt the open list: a cycle, and a search that never ends. This side keeps its search state in a
+// table of its own and never reads nor writes those four fields. The table is emptied by every new search.
+namespace
+{
+	struct SearchState
+	{
+		CNavArea *next = NULL;
+		CNavArea *prev = NULL;
+		bool open = false;
+		bool marked = false;
+	};
+
+	std::unordered_map<const CNavArea *, SearchState> s_searchState;
+
+	// Every area on the list has an entry, so a walk longer than the table is a cycle.
+	void AbandonSearch( CNavArea **openList, CNavArea **openListTail )
+	{
+		g_pSM->LogError( myself, "Nav area open list is corrupt, abandoning the search." );
+		s_searchState.clear();
+		*openList = NULL;
+		*openListTail = NULL;
+	}
+}
+
+void CNavArea::Mark( void )
+{
+	s_searchState[this].marked = true;
+}
+
+BOOL CNavArea::IsMarked( void ) const
+{
+	auto it = s_searchState.find( this );
+	return ( it != s_searchState.end() && it->second.marked ) ? true : false;
+}
+
+bool CNavArea::IsOpen( void ) const
+{
+	auto it = s_searchState.find( this );
+	return it != s_searchState.end() && it->second.open;
+}
