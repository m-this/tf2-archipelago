# Copy this file to .env in the root of the repository. Git ignores .env. Git
# keeps this file.
#
# The stack refuses to start without AP_HOST, AP_PORT and SRCDS_RCONPW. This
# file fills in AP_HOST. The other two are yours.

# --- The multiworld ---

# Where the multiworld runs. The default is a room on archipelago.gg: generate
# a seed with `make seed`, upload the file it writes to ./seed at
# https://archipelago.gg/uploads, and create a room. The room page gives the
# address to put here.
#
# To add optional services, set COMPOSE_PROFILES to their comma-separated
# profile names. `selfhost` runs the multiworld here; `tailscale-fastdl`
# publishes map downloads without a forwarded HTTP port.
AP_HOST=archipelago.gg

# The port of the room. A new room gets a new port, so this has no default.
AP_PORT=

# archipelago.gg answers wss:// on the port of the room. A multiworld inside
# the stack does not.
AP_TLS=true

# Hosts the multiworld in the stack rather than on archipelago.gg. This adds
# the `archipelago` service back and generates the seed at the first start.
#COMPOSE_PROFILES=selfhost

# The name of the multiworld slot. One slot covers the whole game server.
AP_SLOT_NAME=tf2

# The password of the multiworld. An empty value sets no password. Set the one
# you gave the room here: a room on archipelago.gg answers anybody who has its
# address.
AP_PASSWORD=

# --- The run ---
#
# `make seed` reads these values, and the seed keeps them. Changing one later
# needs a new seed and a new room.

# How many missions the run uses. Eight missions take about one evening.
MVM_MISSION_COUNT=8

# The easiest tier that the run can draw. The run also draws every tier above
# it. Set normal, intermediate, advanced or expert.
#
# Do not set haunted. That tier holds one mission, which gives too few checks
# for the items of a run, and generation stops with an error.
MVM_DIFFICULTY=intermediate

# What ends the run: final_boss or missionsanity.
MVM_GOAL=final_boss

# How much of the run Missionsanity asks for. The final_boss goal ignores it.
MVM_MISSIONSANITY_PERCENTAGE=80

# DeathLink: a lost wave kills every linked player in the multiworld, and one
# of their deaths wipes your team, which loses the wave.
MVM_DEATH_LINK=false

# Missions the run never draws, whatever the tier. Popfile names, separated by
# commas. mvm_ghost_town_666 keeps out Caliginous Caper, one wave of 666 robots
# that takes an hour on its own.
MVM_EXCLUDED_MISSIONS=

# Whether the run draws community missions at all. Every one the server can
# play is in the pool by default; false keeps the run to Valve's missions
# without naming each community one above.
MVM_COMMUNITY_MISSIONS=true

# The mission the run starts on, as a popfile name. `random` starts the run on
# the easiest mission it drew.
MVM_START_MISSION=random

# The mercenary the run starts with. `random` draws every starting class.
MVM_START_CLASS=random

# --- The game server ---

SRCDS_HOSTNAME=Mann vs Archipelago

# Required. The stack publishes no port for rcon, so this password stays on the
# machine.
SRCDS_RCONPW=

# The password to join the server. An empty value lets anybody with the address
# join.
SRCDS_PW=

# The only public port of the stack.
SRCDS_PORT=27015

# Team Fortress 2 refuses to host Mann vs Machine unless the server has 32
# slots. It caps the RED team at six itself, which is what the mode is balanced
# for. A lower value here does not make a smaller game, it makes the server
# print "You must set maxplayers to 32" and restart in a loop.
SRCDS_MAXPLAYERS=32

# The map the server starts on. Set any mvm_ map.
SRCDS_STARTMAP=mvm_decoy

# The mission the server starts on, as a popfile name, once the map is up. It
# has to be a mission of the run that the run has unlocked; the plugin moves
# to the first unlocked mission otherwise, and it does the same at every map
# change. Empty keeps the map's own mission, which is subject to the same rule.
SRCDS_START_MISSION=

# Seconds between a mission clear and the next unlocked mission loading. 0
# leaves the game's own cycle to it.
TF2AP_NEXT_MISSION_DELAY=30

# Who is an admin, by Steam id, separated by commas. Either form works: the 17
# digit id from a profile URL (76561198014216803) or SourceMod's own
# (STEAM_0:1:26975537). The long one is converted at start. Find one with
# steamid.io, or type status in the server console while connected.
#
# Every id here gets root on this server: the mission switcher (!mission) and
# every sm_ap_ command. Empty means nobody is an admin and those commands are
# reachable only through rcon.
SRCDS_ADMIN_STEAMIDS=

# Server mods the game server loads, by key, separated by commas. Some
# community missions need one, and the run draws those only when the mod is
# named here, both at `make seed` and at `make up`: a seed and a server that
# disagree would ask the server for a mission it cannot run.
#
#   sigsegv-mvm   SigMod. The image carries it; the Windows launcher cannot,
#                 because upstream ships no Windows build.
SRCDS_MODS=

# --- Playing without Archipelago ---

# 1 plays the whole stack without a room and without a seed. The bridge serves a
# multiworld of one on loopback, makes up a seed from the mission count and the
# goal above, and hands out an unlock for every wave the team clears. It also
# plays the other players: they find things, send things over and die, and all of
# it lands in the bridge log and in the game's chat.
#
# Nothing leaves the machine. For trying the stack out, and for play-testing
# when something looks wrong. AP_HOST and AP_PORT are ignored while this is on.
TF2AP_TEST_MODE=0

# --- The defender bots ---

# Team Fortress 2 balances every Mann vs Machine wave for six players on RED.
# With fewer, the robots get through: wave 1 of an Advanced mission is not
# winnable by two people, and the run stalls there.
#
# So the server fills RED with bots that actually play: they pick classes, fight,
# buy their own upgrades and ready themselves. 1 spawns them when a wave begins
# and keeps the team topped up for the rest of it.
#
# 0 leaves them to an admin's !addbots. The bots are still installed, they just
# do not show up on their own. Worth setting when six humans are playing.
SRCDS_BOTS=1

# How many players RED is filled to, humans included. Six is what the game is
# balanced for. Lower it for a harder run.
SRCDS_BOT_TEAM_SIZE=6

# Classes the bots never play, separated by commas: scout, soldier, pyro,
# demoman, heavyweapons, engineer, medic, sniper, spy. Bots are poor snipers
# and spies.
SRCDS_BOT_CLASS_BLACKLIST=

# The classes the bots fill RED with, in order, separated by commas. Empty
# leaves the mod to draw its own team, which can give three Spies and two
# Scouts on an Advanced mission. The first entries are the seats that get
# filled when the team is short, so put the ones you cannot do without first.
# A team named here beats the blacklist above.
SRCDS_BOT_TEAM_COMP=engineer,medic,heavyweapons,soldier,demoman

# What the bots look like. None of it changes how they play.
#
# A random hat each, drawn from the ones the class can wear, and a random
# unusual effect on that hat, which is six particle effects on screen for a
# whole wave.
SRCDS_BOT_HATS=1
SRCDS_BOT_HAT_EFFECTS=0

# 1 writes what the bots buy at the upgrade station to the chat, since the
# game no longer lets a player inspect a teammate's upgrades. One line per
# purchase.
TF2AP_BOT_UPGRADES_CHAT=0

# Where the players come from. One of three:
#
#   lan     This machine and the local network. No heartbeat to Steam, no Steam
#           authentication of the players who join, no token needed. Nobody
#           outside the network can join, whatever the router does.
#
#   steam   Over Steam Datagram Relay. The server asks Valve for an address in
#           169.254.0.0/16 and prints it at startup; your friends connect to
#           that from anywhere, with nothing forwarded and your own address
#           never shown. The address is a new one on every start.
#
#   port    Straight at SRCDS_PORT, which means forwarding that port to this
#           machine on the router and opening it in the firewall. The default,
#           because a server is usually meant to be joined from somewhere else.
#
# Both steam and port log in to Steam, so both need a real SRCDS_TOKEN. Without
# one the server never gets a Steam session and every client that tries to join
# is refused, the ones on the local network included. So a server with no token
# stays on the local network whatever this says, and prints a line saying so.
#
# steam is not finished: the relay has never been taken all the way to a Team
# Fortress 2 client that joined. The Windows launcher marks the tab that offers
# it beta for that reason.
SRCDS_REACH=lan

# SRCDS_LAN is what SRCDS_REACH replaced, and it still works on its own: 1 is
# lan, 0 is port. Set one or the other. Where both are set, SRCDS_REACH wins.
#
# 1, matching the entrypoint's own default. 0 without a real SRCDS_TOKEN below
# is the one combination that cannot work: the server never logs in to Steam
# and then refuses every client that tries to join.
SRCDS_LAN=1

# The Game Server Login Token from steamcommunity.com/dev/managegameservers,
# for app id 440. The value 0 means none, which is the right answer only for
# SRCDS_REACH=lan: without one nobody outside this machine's network can join.
SRCDS_TOKEN=0

# --- Map downloads ---

# The stack serves the game's maps over HTTP on this port, so a friend joining
# without a community map downloads it from here rather than through the game
# server. The game server's own transfer can reach the end of a large map
# without the client accepting it, and the download then restarts forever.
FASTDL_PORT=27080

# Which host address publishes FASTDL_PORT. The direct FastDL default answers
# the host's networks. Use 127.0.0.1 with Tailscale Funnel: the sidecar reaches
# Caddy inside Compose and no ordinary host HTTP listener is then exposed.
FASTDL_BIND=0.0.0.0

# The address your friends reach this machine at, the same one they put in
# their connect line. The game server writes it into sv_downloadurl, and it
# cannot see it from inside its container, so it is yours to fill in. Empty
# leaves the game server's own transfer as the only way in.
FASTDL_HOST=

# A host of your own instead, as the whole sv_downloadurl value. It wins over
# the two above, and it does not stop this stack serving: the port says whether
# maps are served here, this says where the clients are told to look. Point it
# at your public address, with FASTDL_PORT forwarded on the router, to serve
# friends outside the network.
SRCDS_DOWNLOADURL=

# Tailscale Funnel avoids forwarding FASTDL_PORT at the router. Enable both
# this switch and the `tailscale-fastdl` Compose profile. The official
# Tailscale container logs in once, keeps its node identity in a named volume,
# and supplies its public HTTPS URL to srcds only after Funnel is healthy.
TAILSCALE_FASTDL=0

# A Tailscale auth key is needed for the sidecar's first login. Once the log
# prints the public FastDL URL, its persistent state makes the key unnecessary
# on later starts; remove it from .env. See docs/en/setup/tailscale-fastdl.md.
TAILSCALE_AUTHKEY=

# The device name in the Tailscale admin console and public Funnel hostname.
TAILSCALE_HOSTNAME=tf2-fastdl

# --- Metrics ---

# The bridge serves Prometheus metrics about the run: connected, missions,
# checks, items, and any mission whose wave count the game disagrees with. It is
# a second listener, so the plugin's API stays on loopback where nothing outside
# the game server's namespace can reach it.
BRIDGE_METRICS_PORT=24681

# Which address the metrics port is published on. Loopback by default: a scraper
# on this machine reaches it and nobody else does. Set the host's LAN address to
# let another machine scrape it — the port answers to whoever can open it, so
# this is the only thing that limits who that is.
BRIDGE_METRICS_BIND=127.0.0.1

# --- The images ---

# Only the compose.yaml that a release attaches reads this. A stack that runs
# from a clone builds its own images and ignores it. That file already defaults
# to the release it came with, so leave this unset until you move to another one.
#TF2AP_VERSION=v1.0.0
