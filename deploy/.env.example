# Copy this file to .env in the root of the repository. Git ignores .env. Git
# keeps this file.
#
# Only SRCDS_RCONPW has no default. The stack refuses to start without it.

# --- Archipelago ---

# The name of the multiworld slot. One slot covers the whole game server.
AP_SLOT_NAME=tf2

# The password of the multiworld. An empty value sets no password, which is
# safe while the stack publishes no port for Archipelago.
AP_PASSWORD=

AP_PORT=38281

# --- The run ---

# How many missions the run uses. Eight missions take about one evening.
MVM_MISSION_COUNT=8

# The easiest tier that the run can draw. The run also draws every tier above
# it. Set normal, intermediate, advanced or expert.
#
# Do not set haunted. That tier holds one mission, which gives too few checks
# for the items of a run, and generation stops with an error.
MVM_DIFFICULTY=intermediate

# What ends the run: final_boss or missionsanity.
MVM_GOAL=final_boss

# How much of the run Missionsanity asks for. The final_boss goal ignores it.
MVM_MISSIONSANITY_PERCENTAGE=80

# This bridge does not do DeathLink. A seed that asks for it gets a warning in
# the log and nothing more.
MVM_DEATH_LINK=false

# --- The game server ---

SRCDS_HOSTNAME=Mann vs Archipelago

# Required. The stack publishes no port for rcon, so this password stays on the
# machine.
SRCDS_RCONPW=

# The password to join the server. An empty value lets anybody with the address
# join.
SRCDS_PW=

# The only public port of the stack.
SRCDS_PORT=27015

# Mann vs Machine is balanced for a team of six.
SRCDS_MAXPLAYERS=6

# The mission that the server starts on. Set any mvm_ map.
SRCDS_STARTMAP=mvm_decoy

# The Game Server Login Token from steamcommunity.com/dev/managegameservers.
# The value 0 hides the server from the public list, which is what you want for
# a game with friends.
SRCDS_TOKEN=0
