# Copy to .env at the repository root. .env is gitignored; this file is not.
#
# Only SRCDS_RCONPW has no default and the stack refuses to start without it.

# --- Archipelago ---

# The multiworld slot name. One slot covers the whole game server.
AP_SLOT_NAME=tf2

# Multiworld password. Empty means none, which is fine when nothing is
# published.
AP_PASSWORD=

AP_PORT=38281

# --- The run ---

# How many missions the run spans. Eight is about an evening.
MVM_MISSION_COUNT=8

# The easiest tier that may appear; every harder one comes with it.
# normal, intermediate, advanced, expert.
MVM_DIFFICULTY=intermediate

# final_boss or missionsanity.
MVM_GOAL=final_boss

# How much of the run missionsanity wants. Ignored by final_boss.
MVM_MISSIONSANITY_PERCENTAGE=80

# DeathLink is not implemented. Asking for it gets you a warning in the log
# and nothing else.
MVM_DEATH_LINK=false

# --- The game server ---

SRCDS_HOSTNAME=Mann vs Archipelago

# Required. Never leaves the machine: RCON is not published.
SRCDS_RCONPW=

# Server join password. Empty means anyone with the address can join.
SRCDS_PW=

# The only public port in the stack.
SRCDS_PORT=27015

# Mann vs Machine is balanced around six.
SRCDS_MAXPLAYERS=6

# Which mission the server boots into. Any mvm_ map.
SRCDS_STARTMAP=mvm_decoy

# Game Server Login Token, from steamcommunity.com/dev/managegameservers.
# Zero runs the server unlisted, which is what you want for friends.
SRCDS_TOKEN=0
