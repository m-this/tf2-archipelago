# Archipelago, pinned, headless, with our apworld built in.
#
# custom_worlds/ takes .apworld zips only: a folder there is found and then
# fails to import, so the world is packaged during the build.
# websockets 14 removed ServerConnection.open, which MultiServer.py calls on
# every connection, and setuptools 81 dropped pkg_resources, which ModuleUpdate
# imports at startup. Both pins are load-bearing.

FROM python:3.13-slim AS build

ARG ARCHIPELAGO_VERSION

RUN apt-get update \
	&& apt-get install --yes --no-install-recommends curl ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /ap
RUN curl -fsSL "https://github.com/ArchipelagoMW/Archipelago/archive/refs/tags/${ARCHIPELAGO_VERSION}.tar.gz" \
	| tar xz --strip-components=1

# The launcher's GUI and a Windows debugger binding: nothing headless needs
# them, and KivyMD is a git dependency that would drag in a toolchain.
RUN grep -vE '^(kivy|kivymd|Pymem)' requirements.txt > /tmp/requirements.txt \
	&& pip install --no-cache-dir -r /tmp/requirements.txt "setuptools<81"

COPY apworld/tf2_mvm /ap/worlds/tf2_mvm

# The game name comes out of the export, which gamedata owns. meta.json is kept
# beside the packaged world so the entrypoint reads the same one.
RUN game=$(python -c "import json; print(json.load(open('/ap/worlds/tf2_mvm/data/meta.json'))['game'])") \
	&& SKIP_REQUIREMENTS_UPDATE=1 python Launcher.py "Build APWorlds" -- "$game" \
	&& mkdir -p /ap/custom_worlds \
	&& cp /ap/worlds/tf2_mvm/data/meta.json /ap/custom_worlds/meta.json \
	&& rm -rf /ap/worlds/tf2_mvm \
	&& cp /ap/build/apworlds/tf2_mvm.apworld /ap/custom_worlds/


# The world's tests need Archipelago around them. Loading the folder and the
# packaged copy at once would declare the same game twice, so the zip goes.
FROM build AS apworld-test

ENV SKIP_REQUIREMENTS_UPDATE=1
COPY apworld/tf2_mvm /ap/worlds/tf2_mvm
RUN rm -f /ap/custom_worlds/tf2_mvm.apworld
CMD ["python", "-m", "unittest", "discover", "-s", "worlds/tf2_mvm/test", "-t", "."]


FROM python:3.13-slim

# ModuleUpdate.py blocks on input() over every world's optional dependencies.
ARG ARCHIPELAGO_VERSION
ENV SKIP_REQUIREMENTS_UPDATE=1 \
	PYTHONUNBUFFERED=1 \
	ARCHIPELAGO_VERSION=${ARCHIPELAGO_VERSION}

RUN useradd --create-home --uid 1000 archipelago
COPY --from=build /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=build /usr/local/bin /usr/local/bin
COPY --from=build --chown=archipelago:archipelago /ap /ap
COPY --chown=archipelago:archipelago deploy/archipelago-entrypoint.sh /usr/local/bin/entrypoint.sh

# A named volume takes its ownership from the directory it covers, so this must
# exist and belong to the right user before VOLUME declares it.
RUN mkdir -p /ap/output /ap/Players \
	&& chown archipelago:archipelago /ap/output /ap/Players

USER archipelago
WORKDIR /ap
VOLUME ["/ap/output"]
EXPOSE 38281

# A real WebSocket handshake, not a bare TCP connect: the multiworld server
# answers a plain connection with 400 and a log line, so the naive check both
# lies and fills the log.
# close_timeout matters: the server is slow to answer a close frame, and the
# ten-second default outlives the check itself.
HEALTHCHECK --interval=15s --timeout=10s --start-period=180s --retries=5 \
	CMD python -c "import os; from websockets.sync.client import connect; connect('ws://127.0.0.1:' + os.environ.get('AP_PORT', '38281'), open_timeout=3, close_timeout=1).close()" || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
